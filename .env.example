# ============================================
# AutoNewsAnalyzer - 环境配置示例
# ============================================
# 复制此文件为 .env 并修改相应配置
# ============================================

# ============ 系统配置 ============
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-to-a-secure-random-string
TZ=Asia/Shanghai

# ============ 数据库配置 ============
# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=autonews_analyzer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSL_MODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Elasticsearch
ELASTICSEARCH_HOSTS=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ============ 外部API配置 ============
# 新闻源API
NEWS_API_KEY=your_news_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
FINNHUB_API_KEY=your_finnhub_key_here

# AI服务API
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
# DeepSeek（知识提取的可选增强，未配置时自动降级为规则提取）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ============ 爬虫配置 ============
CRAWLER_USER_AGENT=Mozilla/5.0 (compatible; AutoNewsAnalyzer/2.0; +http://autonews.dev/bot)
CRAWLER_REQUEST_TIMEOUT=30
CRAWLER_MAX_RETRIES=3
CRAWLER_RATE_LIMIT_DELAY=1.0
CRAWLER_MAX_CONCURRENT=10

# ============ 可信度评估配置 ============
CREDIBILITY_MIN_SCORE=0.7
CREDIBILITY_AUTO_LEARN=true
CREDIBILITY_WEIGHT_SOURCE=0.35
CREDIBILITY_WEIGHT_FRESHNESS=0.20
CREDIBILITY_WEIGHT_AUTHOR=0.15
CREDIBILITY_WEIGHT_CONTENT=0.20
CREDIBILITY_WEIGHT_URL=0.10

# ============ 知识图谱配置 ============
KNOWLEDGE_GRAPH_STORAGE=postgres  # memory, postgres, neo4j, elasticsearch
VECTOR_STORAGE=elasticsearch      # elasticsearch, faiss, qdrant
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ============ 进化配置 ============
EVOLUTION_ENABLED=true
EVOLUTION_LEARNING_RATE=0.01
EVOLUTION_META_COGNITIVE=true
EVOLUTION_GOAL_SETTING=true

# ============ 内存管理配置 ============
MEMORY_RETENTION_BREAKING_NEWS=7
MEMORY_RETENTION_RESEARCH=180
MEMORY_RETENTION_FUNDAMENTAL=0  # 0表示永久保留

# ============ API服务器配置 ============
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=4
API_RELOAD=true

# ============ 监控配置 ============
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# ============ 性能配置 ============
MAX_CONCURRENT_TASKS=10
BATCH_SIZE=100
CACHE_TTL=3600
CACHE_ENABLED=true

# ============ 存储配额 ============
MAX_STORAGE_GB=100
MAX_LOG_SIZE_MB=1000
BACKUP_RETENTION_DAYS=30
AUTO_CLEANUP_ENABLED=true

# ============ 数据源配置 ============
# RSS源示例
RSS_TECHCRUNCH=https://techcrunch.com/feed/
RSS_ARXIV=https://arxiv.org/rss/cs
RSS_REUTERS=https://www.reutersagency.com/feed/

# API源示例
NEWSAPI_ENABLED=false
ALPHA_VANTAGE_ENABLED=false
FINNHUB_ENABLED=false

# ============ 测试配置 ============
TEST_DATA_PATH=./tests/data
TEST_MOCK_ENABLED=true
TEST_MOCK_COUNT=100

# ============ 开发配置 ============
PYTHONPATH=.
PYTHONUNBUFFERED=1